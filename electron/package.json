{
  "name": "pharma-checkout-desktop",
  "productName": "1PH1 - Pharmacy POS",
  "version": "1.0.0",
  "description": "Native Windows desktop wrapper for the 1PH1 pharmacy POS (built on top of the existing Expo web build).",
  "author": {
    "name": "1PH1 Team",
    "email": "support@1ph1.local"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ELECTRON_DEV=1 electron .",
    "dist": "electron-builder --win --publish never",
    "dist:msi": "electron-builder --win msi --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-pos-printer": "^1.3.6",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.oneph1.pos",
    "productName": "1PH1 Pharmacy POS",
    "asar": true,
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "config", "to": "config" }
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "1PH1",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "1PH1 POS",
      "installerLanguages": ["ar-SA", "en-US"],
      "language": "1025"
    },
    "portable": {
      "artifactName": "1PH1-POS-${version}-portable.exe"
    }
  }
}
